<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Form View - Lớp học -->
    <record id="view_edu_session_form" model="ir.ui.view">
        <field name="name">edu.session.form</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <form string="Lớp học">
                <header>
                    <button name="action_open" string="Mở đăng ký"
                            type="object" invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_done" string="Hoàn thành"
                            type="object" invisible="state != 'open'"
                            class="oe_highlight"/>
                    <button name="action_cancel" string="Hủy"
                            type="object"
                            invisible="state in ['done', 'cancel']"/>
                    <button name="action_draft" string="Đặt lại Nháp"
                            type="object" invisible="state != 'cancel'"
                            groups="edu_management.group_edu_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,done"/>
                </header>
                <sheet string="Lớp học" readonly="state == 'done'">
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" readonly="1"/>
                            <field name="course_id"/>
                            <field name="instructor_id"/>
                            <field name="classroom_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="duration"/>
                            <field name="end_date"/>
                            <field name="seats"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Học viên" name="attendees">
                            <group>
                                <field name="attendee_count"/>
                                <field name="taken_seats" widget="progressbar"/>
                            </group>
                            <field name="attendee_ids">
                                <tree string="Học viên">
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Tài chính" name="financial">
                            <group>
                                <field name="revenue" widget="monetary" groups="edu_management.group_edu_manager"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Tree View - Lớp học -->
    <record id="view_edu_session_tree" model="ir.ui.view">
        <field name="name">edu.session.tree</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <tree string="Lớp học" 
                  decoration-danger="taken_seats &gt;= 100" 
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="code"/>
                <field name="course_id"/>
                <field name="instructor_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration"/>
                <field name="seats"/>
                <field name="attendee_count"/>
                <field name="taken_seats" widget="progressbar"/>
                <field name="state"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>
    
    <!-- Search View - Lớp học -->
    <record id="view_edu_session_search" model="ir.ui.view">
        <field name="name">edu.session.search</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Lớp học">
                <field name="name"/>
                <field name="code"/>
                <field name="course_id"/>
                <field name="instructor_id"/>
                
                <filter string="Nháp" name="filter_draft" 
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Đã xác nhận" name="filter_confirmed" 
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Hoàn thành" name="filter_done" 
                        domain="[('state', '=', 'done')]"/>
                
                <separator/>
                <filter string="Còn chỗ" name="filter_available" 
                        domain="[('taken_seats', '&lt;', 100)]"/>
                <filter string="Đã đầy" name="filter_full" 
                        domain="[('taken_seats', '&gt;=', 100)]"/>
                
                <group expand="0" string="Nhóm theo">
                    <filter string="Khóa học" name="group_course" 
                            context="{'group_by': 'course_id'}"/>
                    <filter string="Giảng viên" name="group_instructor" 
                            context="{'group_by': 'instructor_id'}"/>
                    <filter string="Trạng thái" name="group_state" 
                            context="{'group_by': 'state'}"/>
                    <filter string="Ngày bắt đầu" name="group_start_date" 
                            context="{'group_by': 'start_date'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Kanban View - Lớp học -->
    <record id="view_edu_session_kanban" model="ir.ui.view">
        <field name="name">edu.session.kanban</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="course_id"/>
                <field name="instructor_id"/>
                <field name="start_date"/>
                <field name="state"/>
                <field name="taken_seats"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <span class="float-end badge badge-pill">
                                    <field name="state"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="course_id"/>
                                <br/>
                                <field name="instructor_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="start_date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="taken_seats" widget="progressbar"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Calendar View - Lớp học -->
    <record id="view_edu_session_calendar" model="ir.ui.view">
        <field name="name">edu.session.calendar</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <calendar string="Lịch Lớp học" date_start="start_date" date_stop="end_date"
                      color="instructor_id" mode="month">
                <field name="name"/>
                <field name="course_id"/>
                <field name="instructor_id"/>
            </calendar>
        </field>
    </record>
    
    <!-- Graph View - Lớp học -->
    <record id="view_edu_session_graph" model="ir.ui.view">
        <field name="name">edu.session.graph</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <graph string="Thống kê Lớp học" type="bar">
                <field name="course_id"/>
                <field name="attendee_count" type="measure"/>
            </graph>
        </field>
    </record>
    
    <!-- Pivot View - Lớp học -->
    <record id="view_edu_session_pivot" model="ir.ui.view">
        <field name="name">edu.session.pivot</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <pivot string="Phân tích Lớp học">
                <field name="course_id" type="row"/>
                <field name="instructor_id" type="col"/>
                <field name="attendee_count" type="measure"/>
                <field name="revenue" type="measure"/>
            </pivot>
        </field>
    </record>

</odoo>
