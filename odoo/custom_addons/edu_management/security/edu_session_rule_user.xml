<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- User chỉ thấy lớp do mình tạo hoặc phụ trách -->
        <record id="edu_session_rule_user" model="ir.rule">
            <field name="name">Session: User only see own or instructor</field>
            <field name="model_id" ref="model_edu_session"/>
            <field name="domain_force">['|',('create_uid','=',user.id),('instructor_id','=',user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('edu_management.group_edu_user'))]"/>
        </record>
    </data>
</odoo>
